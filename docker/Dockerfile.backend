# SafShekan-style multi-stage (npm workspaces)
FROM node:22-alpine AS base
WORKDIR /app

FROM base AS builder
COPY package.json package-lock.json .npmrc* ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/
COPY packages/shared/package.json ./packages/shared/
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build -w @zarva/shared
RUN npx prisma generate --schema=apps/backend/prisma/schema.prisma
RUN npm run build -w @zarva/backend

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs zarva \
  && mkdir -p /app/data \
  && chown -R zarva:nodejs /app

COPY --from=builder --chown=zarva:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=zarva:nodejs /app/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=builder --chown=zarva:nodejs /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder --chown=zarva:nodejs /app/apps/backend/package.json ./apps/backend/
COPY --from=builder --chown=zarva:nodejs /app/apps/backend/prisma ./apps/backend/prisma
COPY --from=builder --chown=zarva:nodejs /app/packages/shared ./packages/shared
COPY --from=builder --chown=zarva:nodejs /app/package.json ./package.json

USER zarva
EXPOSE 3000
ENV PORT=3000
ENV BACKEND_PORT=3000

CMD ["node", "apps/backend/dist/main.js"]
