NODE_ENV=production
PORT=3000

# Host publish (SafShekan-style compose)
BACKEND_PORT=5030
FRONTEND_PORT=5031
NGINX_PORT=5032

BACKEND_IMAGE=ghcr.io/OWNER/zarva-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/zarva-frontend:latest

POSTGRES_DB=zarva_db
POSTGRES_USER=zarva
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
DATABASE_URL=postgresql://zarva:replace_with_a_secure_postgres_password@postgres:5432/zarva_db?schema=public

REDIS_PASSWORD=replace_with_a_secure_redis_password
REDIS_URL=redis://:replace_with_a_secure_redis_password@redis:6379
REDIS_MAXMEMORY=128mb

JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=7d

MINIO_ACCESS_KEY=zarva
MINIO_SECRET_KEY=zarva-secret-key
MINIO_BUCKET=zarva
MINIO_PUBLIC_PORT=9030
MINIO_CONSOLE_PORT=9031
MINIO_USE_SSL=false
# IR/VPS: use Arvan mirror (default in compose). Override only if needed.
# MINIO_IMAGE=docker.arvancloud.ir/minio/minio:RELEASE.2022-10-24T18-35-07Z

# Public URLs (nginx gateway)
NEXT_PUBLIC_API_URL=https://5.159.49.36:5032/api/v1
NEXT_PUBLIC_APP_URL=https://5.159.49.36:5032
APP_URL=https://5.159.49.36:5032
CORS_ORIGIN=https://5.159.49.36:5032
COOKIE_SECURE=false

BILLING_PROVIDER=mock
SWAGGER_ENABLED=false
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
EMAIL_FROM=ZARVA <noreply@zarva.dev>
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
