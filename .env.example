# App
NODE_ENV=development
APP_VERSION=0.1.0

# Database (host ports match docker-compose)
DATABASE_URL=postgresql://zarva:zarva@localhost:5433/zarva?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_ACCESS_KEY=zarva
MINIO_SECRET_KEY=zarva-secret-key
MINIO_BUCKET=zarva
MINIO_USE_SSL=false

# Backend
BACKEND_PORT=4100
CORS_ORIGIN=http://localhost:3100
COOKIE_SECURE=false
JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SWAGGER_ENABLED=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3100
PORT=3100

# Billing (Stripe — leave empty to use MockBillingProvider)
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SUBSCRIPTION_EXPIRY_WARN_DAYS=7
APP_URL=http://localhost:3100
EMAIL_FROM=ZARVA <noreply@zarva.dev>
RESEND_API_KEY=

# Trial
TRIAL_DAYS=14

# SMS (Kavenegar) — console logs OTP in development; use kavenegar in production
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=zarva-otp
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE_SALE_CONFIRMED=zarva-sale-confirmed
KAVENEGAR_TEMPLATE_SALE_PAYMENT_PARTIAL=zarva-sale-payment-partial
KAVENEGAR_TEMPLATE_SALE_PAYMENT_PAID=zarva-sale-payment-paid
KAVENEGAR_TEMPLATE_SALE_READY=zarva-sale-ready
KAVENEGAR_TEMPLATE_SALE_COMPLETED=zarva-sale-completed
KAVENEGAR_TEMPLATE_SALE_VOID=zarva-sale-void

# Live market rates (dashboard)
# Optional paid keys — free TGJU + gold-api.com used by default
GOLD_API_KEY=
NAVASAN_API_KEY=
MARKETS_POLL_MS=15000
